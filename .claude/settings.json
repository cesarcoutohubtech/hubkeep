      "PowerShell(supabase start*)",
      "PowerShell(supabase db reset --linked*)",
      "PowerShell(git push --force*)",
      "PowerShell(Get-Content .env)",
      "PowerShell(Get-Content .env.local)",
      "PowerShell(Get-Content .env.*.local)"
    ],
    "ask": [
      "Bash(supabase db push*)",
      "Bash(supabase config push*)",
      "PowerShell(supabase db push*)",
      "PowerShell(supabase config push*)"
    ]
  }
}
