{
  "name": "hubkeep",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "dev": "turbo run dev --filter=@hubkeep/web --filter=@hubkeep/tecnico",
    "typecheck": "tsc --noEmit -p . && turbo run typecheck",
    "test": "turbo run test && vitest run",
    "db:testar-dev": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/ops/testar-banco-dev.mjs",
    "db:papeis": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/ops/configurar-papeis.ts",
    "db:verificar-papeis": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/ops/verificar-papeis.ts",
    "db:types": "pnpm --filter @hubkeep/db db:types",
    "db:fumaca": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/ops/fumaca-db.ts",
    "ops:modulo": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/ops/modulo-contratado.ts",
    "ops:config-remota": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/ops/ler-config-remota.ts",
    "ops:provisionar": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/ops/provisionar-cliente.ts",
    "ops:recalcular-inteligencia": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/ops/recalcular-inteligencia.ts",
    "demo:dados": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/ops/dados-demonstracao.ts",
    "demo:historico": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/ops/historico-demonstracao.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-formatjs": "^8.1.1",
    "globals": "^17.13.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.5"
  }
}
