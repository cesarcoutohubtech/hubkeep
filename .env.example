# Modelo de todas as variáveis de ambiente lidas no repositório, sem valores.
# O teste tests/env-example.test.ts varre o código e falha se uma variável lida
# não estiver aqui, e também se uma variável daqui não for lida por ninguém. As
# que já têm nome mas ainda não têm código ficam comentadas no fim, em
# "Reservadas". Valores reais nunca entram no git (.gitignore cobre .env*).
#
# Três grupos: APP (o que roda na Vercel e na rede do cliente), TESTES (CI e
# integração) e OPERAÇÃO (scripts/ops e Supabase CLI, na máquina da pessoa
# autorizada; nunca na Vercel).

# ===========================================================================
# APP
# ===========================================================================

# ---------------------------------------------------------------------------
# apps/web (Vercel)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=      # chave pública (anon); só autentica
SUPABASE_SECRET_KEY=                       # service_role; lida SOMENTE por packages/auth-admin
HK_URL_SITE=                               # base pública do web, usada no link do convite (ex.: https://app.hubkeep...)
NEXT_PUBLIC_URL_DO_TECNICO=                # base pública do PWA, impressa no QR do ativo (ex.: https://tecnico.hubkeep.com.br; no dev, http://localhost:5173)

# Conexões via Supavisor, modo transação (porta 6543). Usuário: <papel>.<ref_do_projeto>
# Sem ?sslmode nem ?ssl: o TLS, com o certificado conferido contra a CA do Supabase, é do HubKeep (ADR-032).
DATABASE_URL_APP=postgresql://hk_app.<ref>:<senha>@<host-pooler>:6543/postgres
DATABASE_URL_WORKER=postgresql://hk_worker.<ref>:<senha>@<host-pooler>:6543/postgres
DATABASE_URL_INGESTAO=postgresql://hk_ingestao.<ref>:<senha>@<host-pooler>:6543/postgres

# 1 desliga o TLS da conexão do app. Só é aceito com o banco em localhost,
# 127.0.0.1 ou ::1 (a CI); com outro host a inicialização falha. Nunca na Vercel.
HK_BANCO_SEM_TLS=

# Project ref do Supabase de produção (20 letras e números). Vai para todos os
# ambientes da Vercel: no preview, a inicialização recusa conexão com esse
# projeto e falha se a variável faltar (M2 do docs/11). Não é segredo.
HK_REF_PRODUCAO=

CRON_SECRET=

# 1 libera o pseudo-idioma (en-XA: acentos e texto ~35% mais longo, ADR-022)
# pelo seletor de idioma. Só dev e homologação; em produção fica vazio, e
# VERCEL_ENV=production o desliga mesmo que alguém o ligue.
HK_PSEUDO_IDIOMA=
VERCEL_ENV=                                # definida pela Vercel (production, preview, development); não se configura à mão

# Sentry (F0-07). Sem DSN, nada é enviado (dev e CI). SENTRY_ENVIRONMENT
# separa dev, staging e produção no painel do Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# ---------------------------------------------------------------------------
# apps/tecnico (Vercel, site estático)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=                              # base da API no build (ex.: https://app.hubkeep...); vazia no dev, que usa o proxy do Vite
VITE_PSEUDO_IDIOMA=                        # 1 libera o pseudo-idioma no seletor (só dev; o build de produção ignora)
HK_API_DEV=                                # destino do proxy /api do Vite no dev e no preview (padrão http://localhost:3000)

# ---------------------------------------------------------------------------
# apps/conector (rede do cliente; NUNCA credencial do banco do HubKeep)
# ---------------------------------------------------------------------------
CONECTOR_API_URL=
CONECTOR_CREDENCIAL=                       # hk_<tenant_id>_<segredo>
CONECTOR_FONTE=                            # planilha | totvs_cm
CONECTOR_ARQUIVO_HOTEIS=                   # CSV de hotéis (fonte planilha): codigo, nome
CONECTOR_ARQUIVO_UHS=                      # CSV de UHs (fonte planilha): codigo, hotel, nome, andar

# ===========================================================================
# TESTES (CI e integração)
# ===========================================================================
# Sem estas URLs as suítes de integração são puladas (ADR-015: sem banco na
# máquina). Na CI apontam para o Supabase local do runner; o pnpm db:fumaca as
# monta sozinho para o dev, sem passar pela tela.
HK_TESTE_URL_APP=                          # hk_app
HK_TESTE_URL_WORKER=                       # hk_worker
HK_TESTE_URL_INGESTAO=
HK_TESTE_URL_DONO=                         # postgres: fixtures e conferência do que foi gravado
HK_TESTE_VIA_POOLER=                       # 1 quando APP/WORKER passam pelo Supavisor (fumaça no dev)
HK_EXIGIR_BANCO=                           # 1 faz a falta de banco ser falha, não suíte pulada (CI)
HK_MAILPIT_URL=                            # Mailpit do Supabase local, onde chega o convite (CI)
HK_ATUALIZAR_TEMPLATES=                    # 1 regenera supabase/templates a partir do catálogo (tests/i18n-templates)

# Dono do Postgres local da CI, para scripts/ops com --ambiente ci. O host
# precisa ser local: o ambiente ci conecta sem TLS e grava fixtures.
CI_DATABASE_URL_OWNER=
# Senhas dos papéis no ambiente ci: geradas pela CI a cada execução, mascaradas
# no log. Localmente não se usam.
HK_APP_SENHA_CI=
HK_WORKER_SENHA_CI=
HK_INGESTAO_SENHA_CI=

# ===========================================================================
# OPERAÇÃO (scripts/ops e Supabase CLI; NUNCA na Vercel nem no git)
# ===========================================================================
DEV_SESSION_POOLER=                        # string Session pooler do HubKeep-dev (contém a senha); psql, db:types e scripts/ops --ambiente dev
PSQL=                                      # caminho do psql, se não estiver no PATH (db:testar-dev)
SUPABASE_ACCESS_TOKEN=                     # token pessoal da Management API; só leitura e só no dev (scripts/ops/ler-config-remota.ts)

# Dono (postgres) do staging e da produção, para scripts/ops --ambiente
# staging|producao. Só na máquina da pessoa autorizada, só enquanto usar.
DATABASE_URL_OWNER=

# Senhas dos papéis da aplicação, lidas por scripts/ops/configurar-papeis.ts
# (uma por papel; mínimo 32 caracteres, ASCII imprimível). Só ci e dev: em
# staging e produção a senha é digitada no terminal, sem eco, e não existe
# variável para ela.
# O script envia só o verificador SCRAM-SHA-256, nunca a senha. verificar-papeis
# e db:fumaca leem as de hk_app e hk_worker.
HK_APP_SENHA_DEV=
HK_WORKER_SENHA_DEV=
HK_INGESTAO_SENHA_DEV=

# Dados de demonstração do kit de teste (pnpm demo:dados, no dev ou no staging
# do treinamento; docs/10-kit-de-teste.md). A senha de teste vale para todas as
# contas de demonstração (e-mails .test); mínimo de 12 caracteres. A URL do
# dono e a turma (--turma N) são montadas pelo script, a partir da string do
# dono do ambiente (DEV_SESSION_POOLER ou DATABASE_URL_OWNER); não se configuram.
HK_DEMO_SENHA=
HK_DEMO_URL_DONO=
HK_DEMO_TURMA=

# Provisionamento de cliente (pnpm ops:provisionar, no dev ou no staging;
# docs/10-kit-de-teste.md, seção do provisionamento). Montadas pelo script a
# partir dos argumentos e da string do dono; não se configuram.
HK_PROV_PEDIDO=
HK_PROV_URL_DONO=

# ===========================================================================
# RESERVADAS (comentadas: o nome está combinado, o código que as lê ainda não)
# ===========================================================================
# Descomente junto com o código que lê a variável; o teste passa a exigir as
# duas coisas no mesmo PR.
#
# E-mail próprio e push (fase 1c; a recuperação de senha entra com o e-mail):
# EMAIL_API_KEY=
# EMAIL_REMETENTE=
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
#
# Conector com a fonte totvs_cm (as views reais do TOTVS; B10 do docs/11):
# TOTVS_SQLSERVER_HOST=
# TOTVS_SQLSERVER_DATABASE=
# TOTVS_SQLSERVER_USUARIO=                 # usuário somente leitura
# TOTVS_SQLSERVER_SENHA=
#
# O ref do HubKeep-dev não é variável: os scripts leem [remotes.dev] do
# supabase/config.toml.
